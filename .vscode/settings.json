{
	"chat.tools.terminal.autoApprove": {
		"/^git status --short\nnode --version\nnpm --version$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"npm install": true,
		"npm audit": true
	},
	"cSpell.language": "en,es",
	"cSpell.languageSettings": [{
		"languageId": "*", 
		"caseSensitive": false,
		
	}],
	"cSpell.words": [
		"Burako",
		"Puntaje"
	],
	"files.exclude": {
		"**/dist": true,
		"**/.test-build": true,
		"**/node_modules": true
	}
}